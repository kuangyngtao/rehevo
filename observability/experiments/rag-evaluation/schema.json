{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rehevo RAG Gold Case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "split",
    "category",
    "question",
    "answerable",
    "expectedChunkRefs",
    "referenceAnswer",
    "sourceDocumentHashes",
    "reviewStatus"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^rehevo-gold-v1-[0-9]{3}$"
    },
    "split": {
      "type": "string",
      "enum": ["test"]
    },
    "category": {
      "type": "string",
      "enum": ["fact_lookup", "multi_hop", "semantic_paraphrase", "unanswerable"]
    },
    "question": {
      "type": "string",
      "minLength": 2
    },
    "answerable": {
      "type": "boolean"
    },
    "expectedChunkRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["documentSha256", "chunkIndex"],
        "properties": {
          "documentSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "chunkIndex": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "referenceAnswer": {
      "type": "string"
    },
    "sourceDocumentHashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "reviewStatus": {
      "type": "string",
      "enum": ["draft", "reviewed"]
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "answerable": { "const": true }
        }
      },
      "then": {
        "properties": {
          "expectedChunkRefs": { "minItems": 1 },
          "referenceAnswer": { "minLength": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "answerable": { "const": false }
        }
      },
      "then": {
        "properties": {
          "category": { "const": "unanswerable" },
          "expectedChunkRefs": { "maxItems": 0 }
        }
      }
    }
  ]
}
