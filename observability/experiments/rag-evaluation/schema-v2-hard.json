{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rehevo RAG Gold Case v2-hard",
  "type": "object",
  "required": ["id", "split", "category", "question", "answerable", "expectedChunkRefs", "referenceAnswer", "sourceDocumentHashes", "reviewStatus"],
  "properties": {
    "id": {"type": "string", "pattern": "^rehevo-gold-v2-hard-[0-9]{3}$"},
    "split": {"const": "test"},
    "category": {"enum": ["cross_document", "constraint_reasoning", "distractor_disambiguation", "boundary_refusal"]},
    "question": {"type": "string", "minLength": 2},
    "answerable": {"type": "boolean"},
    "expectedChunkRefs": {"type": "array"},
    "referenceAnswer": {"type": "string", "minLength": 1},
    "sourceDocumentHashes": {"type": "array", "minItems": 1},
    "reviewStatus": {"enum": ["draft", "reviewed"]}
  }
}
